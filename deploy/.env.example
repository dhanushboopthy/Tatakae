# Copy to /opt/tatakae/.env on the VM (chmod 600). Never commit the real file.
GH_OWNER=your-github-username
TAG=latest
DOMAIN=tatakae.yourname.me
ACME_EMAIL=you@example.com
PUBLIC_ORIGIN=https://tatakae.yourname.me
TZ=Asia/Kolkata

OWNER_EMAIL=you@example.com
OWNER_PASSWORD_HASH=   # deploy/scripts/hash-password.sh
SESSION_SECRET=        # openssl rand -hex 32
API_TOKEN=             # openssl rand -hex 32

# OCI Object Storage, S3-compatible (Customer Secret Key under your user profile)
S3_ENDPOINT=https://<namespace>.compat.objectstorage.ap-mumbai-1.oraclecloud.com
S3_REGION=ap-mumbai-1
S3_BUCKET=tatakae-backups
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# DuckDNS (only if using a duckdns.org name)
DUCKDNS_SUBDOMAIN=
DUCKDNS_TOKEN=

# v4
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
KEEP_WARM=0
