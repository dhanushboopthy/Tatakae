{
  "name": "tatakae",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "pnpm --filter api exec tsx ../../db/migrate.ts",
    "dev": "pnpm --filter api --filter web --parallel dev",
    "dev:mobile": "pnpm --filter mobile start"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4"
  }
}
